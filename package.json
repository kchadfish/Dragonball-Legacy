{
  "name": "dragonball-resurgence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "dev": "tsx watch apps/api/src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,ts,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,ts,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:game-data": "tsx scripts/generate-game-data.ts && prettier --write packages/game-data/src/reference-documents.ts packages/game-data/src/move-source-definitions.ts",
    "validate:game-data": "tsx scripts/validate-game-data.ts",
    "validate:reference-markdown": "tsx scripts/validate-reference-markdown.ts",
    "check": "npm run format:check && npm run lint && npm run validate:reference-markdown && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
